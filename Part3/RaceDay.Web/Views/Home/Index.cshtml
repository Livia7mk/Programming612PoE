@{
    ViewData["Title"] = "Home";
}

<section class="rd-hero">
    <h1>Find your next race</h1>
    <p>Road running, walking and cycling events across South Africa, all in one place.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="mb-0">You are logged in as <strong>@User.Identity.Name</strong>.</p>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">Create an account</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Log in</a>
    }
</section>